{
  "version": 1,
  "servers": [
    {
      "id": "colab-mcp",
      "name": "Google Colab MCP",
      "enabled": true,
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "--index",
        "https://pypi.org/simple",
        "--from",
        "git+https://github.com/googlecolab/colab-mcp",
        "colab-mcp"
      ],
      "env": {},
      "tool_prefix": "colab-mcp",
      "expose": "all",
      "tools": [],
      "idle_timeout_sec": 600
    }
  ]
}
